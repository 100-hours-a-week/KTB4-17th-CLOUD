{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ECRLogin",
      "Effect": "Allow",
      "Action": [
        "ecr:GetAuthorizationToken"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PublishOnlyBEAndAI",
      "Effect": "Allow",
      "Action": [
        "ecr:DescribeRepositories",
        "ecr:DescribeImages",
        "ecr:BatchGetImage",
        "ecr:GetDownloadUrlForLayer",
        "ecr:BatchCheckLayerAvailability",
        "ecr:InitiateLayerUpload",
        "ecr:UploadLayerPart",
        "ecr:CompleteLayerUpload",
        "ecr:PutImage"
      ],
      "Resource": [
        "arn:aws:ecr:ap-northeast-2:975779326240:repository/star23/be",
        "arn:aws:ecr:ap-northeast-2:975779326240:repository/star23/ai"
      ]
    },
    {
      "Sid": "DescribeEnvironmentClusters",
      "Effect": "Allow",
      "Action": [
        "eks:DescribeCluster"
      ],
      "Resource": [
        "arn:aws:eks:ap-northeast-2:975779326240:cluster/star-EKS-v3",
        "arn:aws:eks:ap-northeast-2:975779326240:cluster/star-EKS-v3-staging"
      ]
    }
  ]
}
